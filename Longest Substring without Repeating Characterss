class Solution {
    public int lengthOfLongestSubstring(String s) {

        char[] arr = s.toCharArray();

        int i = 0;
        int j = 0;
        int max = 0;

        while (j < arr.length) {

            for (int k = i; k < j; k++) {
                if (arr[k] == arr[j]) {
                    i = k + 1;
                    break;
                }
            }

            int len = j - i + 1;

            if (len > max) {
                max = len;
            }

            j++;
        }

        return max;
    }
}
